.vscode/
docs/
bin/
obj/
native/out/
native/out-cuda/
native/out-winx64/
Build/win-x64/
Build/linux-x64/
Build/_linux-x64-cli-tmp/
Build/dist/
Build/runtimes/
*.gguf
*.safetensors
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
DesireeIAServer/build/
