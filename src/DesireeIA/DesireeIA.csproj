<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>DesireeIA</RootNamespace>
    <AssemblyName>DesireeIA</AssemblyName>
  </PropertyGroup>

  <!-- NuGet package metadata. 0.0.1: first public release. 0.0.2: conversation
       session (KV prefix reuse) - see CHANGELOG.md. -->
  <PropertyGroup>
    <PackageId>DesireeIA</PackageId>
    <Version>0.0.3</Version>
    <Authors>Passaro Francesco Paolo</Authors>
    <Description>C# wrapper for DesireeIA, a local LLM inference engine (GGUF models, CPU/CUDA backends). Bundles the native engine for every platform this package was built for - see the runtimes/ folder in the package for what's included.</Description>
    <PackageTags>llm;inference;local;gguf;desireeia;ai</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/francescopaolopassaro/DesireeIA</PackageProjectUrl>
    <RepositoryUrl>https://github.com/francescopaolopassaro/DesireeIA</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>0.0.3: automatic configuration - AutoConfigurator picks backend, threads, RAM budget, non-greedy sampling (temp 0.7, top-k 40, top-p 0.9), context and reply length for the model on the current machine. New AutoConfigurator, AutoConfiguration, ModelTraits and LocalModel.LoadAuto. Full notes: CHANGELOG.md in the repository.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\LICENSE" Pack="true" PackagePath="" />
    <None Include="$(MSBuildThisFileDirectory)..\..\images\web-app-manifest-512x512.png" Pack="true" PackagePath="icon.png" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <!--
    Il motore nativo viene COMPILATO E COPIATO dalla build .NET.

    Prima non era cosi': gli artefatti erano semplici <None
    CopyToOutputDirectory="PreserveNewest">, che copiano solo quando gira una
    build .NET. Ricostruendo solo il nativo con cmake ed eseguendo la CLI,
    quest'ultima continuava a caricare in SILENZIO la copia precedente.
    Costo dell'errore (2026-09-07): un'intera serie di misure di prestazioni
    fatta contro un motore vecchio, con due decisioni tecniche prese di
    conseguenza e poi da rifare. Un disallineamento che non da' alcun segnale
    e' peggio di un errore di compilazione.

    Impostare BuildNativeEngine=false per saltare la compilazione nativa
    (es. su una macchina di sola analisi statica senza cmake).
  -->
  <PropertyGroup>
    <NativeLibBaseName>DesireeIALocaleEngine</NativeLibBaseName>
    <NativeSourceDir>$(MSBuildThisFileDirectory)..\DesireeIA.LocaleEngine</NativeSourceDir>
    <NativeBuildDir>$(MSBuildThisFileDirectory)..\..\native\out</NativeBuildDir>
    <BuildNativeEngine Condition="'$(BuildNativeEngine)' == ''">true</BuildNativeEngine>
  </PropertyGroup>

  <!-- Nome del file prodotto: cambia sui tre sistemi supportati. -->
  <PropertyGroup Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' == 'true'">
    <NativeLibFileName>$(NativeLibBaseName).dll</NativeLibFileName>
  </PropertyGroup>
  <PropertyGroup Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' == 'true'">
    <NativeLibFileName>lib$(NativeLibBaseName).dylib</NativeLibFileName>
  </PropertyGroup>
  <PropertyGroup Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))' == 'true'">
    <NativeLibFileName>lib$(NativeLibBaseName).so</NativeLibFileName>
  </PropertyGroup>

  <Target Name="ConfigureNativeEngine"
          Condition="'$(BuildNativeEngine)' == 'true' AND !Exists('$(NativeBuildDir)\CMakeCache.txt')">
    <Message Importance="high" Text="Configurazione cmake del motore nativo..." />
    <Exec Command="cmake -S &quot;$(NativeSourceDir)&quot; -B &quot;$(NativeBuildDir)&quot; -DCMAKE_BUILD_TYPE=Release" />
  </Target>

  <Target Name="CompileNativeEngine"
          Condition="'$(BuildNativeEngine)' == 'true'"
          DependsOnTargets="ConfigureNativeEngine"
          BeforeTargets="BeforeBuild">
    <Exec Command="cmake --build &quot;$(NativeBuildDir)&quot; --config Release" />
  </Target>

  <!--
    Gli artefatti nativi restano item <None CopyToOutputDirectory>, non una
    <Copy> in un target: solo gli item si propagano ai progetti che
    REFERENZIANO questo (la CLI, i test), che e' esattamente dove serve che la
    libreria finisca. Una <Copy> esplicita riempirebbe solo la cartella di
    output di questo progetto, lasciando la CLI senza libreria.

    Sulla condizione Exists() del file principale: volutamente assente. Il
    target CompileNativeEngine qui sopra garantisce che esista, e se per
    qualche motivo non esistesse e' meglio un errore di build chiaro che una
    copia saltata in silenzio — che era proprio il difetto da eliminare.
    PreserveNewest confronta le date al momento della copia, quindi una
    libreria appena ricompilata viene sempre ripresa.
  -->
  <ItemGroup>
    <None Include="$(NativeBuildDir)\$(NativeLibFileName)"
          Link="$(NativeLibFileName)"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- Runtime MinGW: solo nelle build Windows con quel toolchain. -->
    <None Include="$(NativeBuildDir)\libstdc++-6.dll"
          Condition="Exists('$(NativeBuildDir)\libstdc++-6.dll')"
          Link="libstdc++-6.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NativeBuildDir)\libgcc_s_seh-1.dll"
          Condition="Exists('$(NativeBuildDir)\libgcc_s_seh-1.dll')"
          Link="libgcc_s_seh-1.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NativeBuildDir)\libwinpthread-1.dll"
          Condition="Exists('$(NativeBuildDir)\libwinpthread-1.dll')"
          Link="libwinpthread-1.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Multi-platform NuGet packaging: picks up whatever Build\build.ps1 has
    actually produced under Build\runtimes\<RID>\native\ (see Build\README.md
    for exactly which RIDs are real today vs. still empty placeholders) and
    packs each one under the standard runtimes\<RID>\native\ NuGet convention,
    so `dotnet pack` yields a single package that works on every platform it
    was built for, with no rebuild needed by the consumer.

    Explicit per-file items rather than a %(RecursiveDir)-based wildcard: the
    wildcard form (tried first) produced a doubled path in the packed nupkg
    (runtimes\linux-x64\native\linux-x64\native\...) - %(RecursiveDir) did
    not resolve the way the NuGet docs describe for this SDK version, and
    with only two real RIDs today an explicit list is both correct and no
    harder to maintain. Each item is guarded by Exists() so a RID that
    hasn't been built yet (osx-x64/osx-arm64/linux-arm64 placeholders) is
    silently omitted rather than failing the pack.
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\Build\runtimes\win-x64\native\DesireeIALocaleEngine.dll"
          Pack="true" PackagePath="runtimes\win-x64\native\DesireeIALocaleEngine.dll"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\Build\runtimes\win-x64\native\DesireeIALocaleEngine.dll')" />
    <None Include="$(MSBuildThisFileDirectory)..\..\Build\runtimes\win-x64\native\cudart64_13.dll"
          Pack="true" PackagePath="runtimes\win-x64\native\cudart64_13.dll"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\Build\runtimes\win-x64\native\cudart64_13.dll')" />
    <None Include="$(MSBuildThisFileDirectory)..\..\Build\runtimes\linux-x64\native\DesireeIALocaleEngine.so"
          Pack="true" PackagePath="runtimes\linux-x64\native\DesireeIALocaleEngine.so"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\Build\runtimes\linux-x64\native\DesireeIALocaleEngine.so')" />
    <None Include="$(MSBuildThisFileDirectory)..\..\Build\runtimes\linux-arm64\native\DesireeIALocaleEngine.so"
          Pack="true" PackagePath="runtimes\linux-arm64\native\DesireeIALocaleEngine.so"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\Build\runtimes\linux-arm64\native\DesireeIALocaleEngine.so')" />
    <None Include="$(MSBuildThisFileDirectory)..\..\Build\runtimes\osx-x64\native\libDesireeIALocaleEngine.dylib"
          Pack="true" PackagePath="runtimes\osx-x64\native\libDesireeIALocaleEngine.dylib"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\Build\runtimes\osx-x64\native\libDesireeIALocaleEngine.dylib')" />
    <None Include="$(MSBuildThisFileDirectory)..\..\Build\runtimes\osx-arm64\native\libDesireeIALocaleEngine.dylib"
          Pack="true" PackagePath="runtimes\osx-arm64\native\libDesireeIALocaleEngine.dylib"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\Build\runtimes\osx-arm64\native\libDesireeIALocaleEngine.dylib')" />
  </ItemGroup>

</Project>
